{% extends 'base.html.twig' %}

{% block body %}
  <div class="text-center w-full" style="padding-top: 50px;">
    <h1>Traitement en cours...</h1>
    <p>Veuillez patienter pendant que nous traitons votre demande de rattachement.</p>
    <div class="spinner-border" role="status">
      <span class="visually-hidden">Chargement...</span>
    </div>

    <form id="autoSubmitForm" method="post" action="{{ path('rattachement_newsletter_process') }}">
      <input type="hidden" name="email" value="{{ email }}">
      <input type="hidden" name="partnerId" value="{{ partnerId }}">
    </form>
  </div>

  <script>
    document.addEventListener('DOMContentLoaded', function () {
      document.getElementById('autoSubmitForm').submit();
    });
  </script>
{% endblock %}
