{% extends "default-prehome-page.html.twig" %}

{% block title %}Mot de passe oublié{% endblock %}

{% block content %}
  <form action="{{ path('reset_password') }}" method="post" class="w-full" data-event-name="click_forgot_pass_valider">
    <h1 class="text-md font-bold xl:text-2xl">
      Vous avez oublié votre mot de passe ?
    </h1>
    <div class="mt-5 mx-4">
      <p class="text-sm xl:text-base">
        Renseignez ci-dessous votre <span class="font-bold"> adresse email professionnelle</span> utilisée pour vous
        connecter à la marketplace.
        <br />
        Vous recevrez un email avec un lien pour réinitialiser votre mot de passe.
      </p>

      {% include '_partials/_alert.html.twig' %}

      <div class="flex flex-col sm:flex-row justify-between space-x-2 mt-5 w-full">
        <input
          type="email"
          id="username"
          class="block w-full rounded-lg !border-solid !border-black !ring-black p-2.5 text-sm"
          name="_username"
          value=""
          placeholder="Saisir votre adresse email professionnelle"
          autocomplete="username"
          required
        />
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
        <div class="flex justify-center">
          <button id="formRequestPassword" type="submit" class="flex button button-primary mt-2 xl:mt-0 justify-center w-auto">
            Valider
          </button>
        </div>
      </div>
    </div>

  </form>

{% endblock %}
