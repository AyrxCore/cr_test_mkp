{% extends "default-prehome-page.html.twig" %}
{% block title %}
	Nouveau du mot de passe
{% endblock %}

{% block content %}
	{% if passwordChanged %}
		<div class="w-full">
			{% include '_partials/_alert.html.twig' %}

			<h1 class="text-lg font-bold xl:text-2xl w-full text-center mb-5 text-primary">
				Votre mot de passe a bien été défini
			</h1>
			<p>
				Vous pouvez désormais vous connecter en utilisant votre adresse email et votre nouveau mot de passe.
			</p>
			<div class="flex justify-center w-full mt-6">
				<a href="/" class="flex button button-primary mt-2 xl:mt-0 justify-center w-auto">
					Se connecter
				</a>
			</div>
		</div>

	{% else %}
		{{ form_start(form, {'attr': {'class': 'w-full'}}) }}
		<h1 class="text-lg font-bold xl:text-2xl w-full text-center mb-5 text-primary">
			Saisir votre nouveau mot de passe
		</h1>
		{% set formErrors = form.vars.errors.form.getErrors(true) %}
		{% if formErrors|length %}
			{% for error in formErrors %}
				{% include '_partials/message-alert/_danger.html.twig' with { 'message': error.message } %}
			{% endfor %}
		{% endif %}
		{{ form_row(form.password.first) }}

		<div id="password-checklist" class="hidden mt-2 rounded-md border border-gray-200 bg-gray-50 p-3 text-sm mb-4" style="transition: opacity 0.2s ease;">
			<p class="mb-2 font-medium text-gray-700">Consignes de sécurité :</p>
			<ul class="space-y-1.5">
				<li id="rule-length"  class="flex items-center gap-2 text-red-500"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 icon-svg"><circle cx="12" cy="12" r="10"></circle><path d="m15 9-6 6"></path><path d="m9 9 6 6"></path></svg> Doit contenir au moins 12 caractères.</li>
				<li id="rule-upper"   class="flex items-center gap-2 text-red-500"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 icon-svg"><circle cx="12" cy="12" r="10"></circle><path d="m15 9-6 6"></path><path d="m9 9 6 6"></path></svg> Au moins une majuscule (A-Z).</li>
				<li id="rule-lower"   class="flex items-center gap-2 text-red-500"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 icon-svg"><circle cx="12" cy="12" r="10"></circle><path d="m15 9-6 6"></path><path d="m9 9 6 6"></path></svg> Au moins une minuscule (a-z).</li>
				<li id="rule-digit"   class="flex items-center gap-2 text-red-500"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 icon-svg"><circle cx="12" cy="12" r="10"></circle><path d="m15 9-6 6"></path><path d="m9 9 6 6"></path></svg> Au moins un chiffre (0-9).</li>
				<li id="rule-special" class="flex items-center gap-2 text-red-500"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 icon-svg"><circle cx="12" cy="12" r="10"></circle><path d="m15 9-6 6"></path><path d="m9 9 6 6"></path></svg> Au moins un caractère spécial (ex: !@#$%^&_).</li>
			</ul>
		</div>

		{{ form_row(form.password.second) }}

		<div class="flex justify-center w-fullmt-2">
			<button type="submit" class="flex button button-primary mt-2 xl:mt-0 justify-center w-auto">
				Valider
			</button>
		</div>
		{{ form_end(form) }}

		<script>
			(function () {
				var svgCheck = '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 icon-svg"><circle cx="12" cy="12" r="10"></circle><path d="m9 12 2 2 4-4"></path></svg>';
				var svgX     = '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 icon-svg"><circle cx="12" cy="12" r="10"></circle><path d="m15 9-6 6"></path><path d="m9 9 6 6"></path></svg>';
				var svgEye     = '<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>';
				var svgEyeOff  = '<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path><line x1="1" y1="1" x2="23" y2="23"></line></svg>';

				var rules = [
					{ id: 'rule-length',  test: function(p) { return p.length >= 12; } },
					{ id: 'rule-upper',   test: function(p) { return /[A-Z]/.test(p); } },
					{ id: 'rule-lower',   test: function(p) { return /[a-z]/.test(p); } },
					{ id: 'rule-digit',   test: function(p) { return /[0-9]/.test(p); } },
					{ id: 'rule-special', test: function(p) { return /[^A-Za-z0-9]/.test(p); } },
				];

				function updateRules(val) {
					rules.forEach(function(rule) {
						var el = document.getElementById(rule.id);
						var valid = rule.test(val);
						el.className = 'flex items-center gap-2 transition-colors duration-200 ' + (valid ? 'text-green-600' : 'text-red-500');
						el.querySelector('.icon-svg').outerHTML = valid ? svgCheck : svgX;
					});
				}

				function addEyeToggle(input) {
					var wrapper = input.parentNode;
					var div = document.createElement('div');
					div.style.position = 'relative';
					wrapper.insertBefore(div, input);
					div.appendChild(input);

					var btn = document.createElement('button');
					btn.type = 'button';
					btn.tabIndex = -1;
					btn.innerHTML = svgEyeOff;
					btn.style.cssText = 'position:absolute;right:10px;top:50%;transform:translateY(-50%);background:none;border:none;cursor:pointer;color:#6b7280;padding:0;display:flex;align-items:center;';
					div.appendChild(btn);

					var visible = false;
					btn.addEventListener('click', function() {
						visible = !visible;
						input.type = visible ? 'text' : 'password';
						btn.innerHTML = visible ? svgEye : svgEyeOff;
					});
				}

				document.addEventListener('DOMContentLoaded', function () {
					var inputs = document.querySelectorAll('input[type="password"]');
					var firstInput = inputs[0];
					var checklist = document.getElementById('password-checklist');

					inputs.forEach(function(input) { addEyeToggle(input); });

					if (!firstInput || !checklist) return;

					firstInput.addEventListener('focus', function () {
						checklist.classList.remove('hidden');
						updateRules(firstInput.value);
					});
					firstInput.addEventListener('blur', function () {
						if (firstInput.value === '') checklist.classList.add('hidden');
					});
					firstInput.addEventListener('input', function () {
						updateRules(firstInput.value);
					});
				});
			})();
		</script>
	{% endif %}
{% endblock %}
