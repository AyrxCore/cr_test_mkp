<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>{% block title %}{% endblock %}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    {% block javascripts %}
        {{ vite_asset('main.ts', []) }}

        {# Hamburger menu logic #}
        <script type="text/javascript">
          const initApp = () => {
              const openMenuBtn = document.getElementById('open-menu-button')
              const closeMenuBtn = document.getElementById('close-menu-button')
              const mobileMenu = document.getElementById('mobile-menu')

              const toggleMenu = () => {
                  openMenuBtn.classList.toggle('hidden')
                  openMenuBtn.classList.toggle('flex')
                  closeMenuBtn.classList.toggle('hidden')
                  closeMenuBtn.classList.toggle('flex')
                  mobileMenu.classList.toggle('hidden')
                  mobileMenu.classList.toggle('fixed')
                  mobileMenu.classList.toggle('flex')
                  document.body.classList.toggle('overflow-hidden')
                  document.body.classList.toggle('fixed')
              }

              openMenuBtn.addEventListener('click', toggleMenu)
              closeMenuBtn.addEventListener('click', toggleMenu)
          }

          document.addEventListener('DOMContentLoaded', initApp)
        </script>
    {% endblock %}
</head>
<body>
  <div class="vue-app" data-component="sticky-contact-buttons"></div>
  {{ include('_partials/_header.html.twig') }}
  {% set messages = app.flashes %}
  {% if messages | length %}
      <div class="m-auto w-1/2 mt-2">
          {% for type, message in messages %}
              <div class="p-4 mb-4 text-sm text-{{ type }}-700 bg-{{ type }}-100 rounded-lg" role="alert">
                  {{ message[0] }}
              </div>
          {% endfor %}
      </div>
  {% endif %}
    {% block body %}
    {% endblock %}
{{ include('_partials/_footer.html.twig') }}
</body>
</html>
