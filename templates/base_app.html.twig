<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <title>
    {% block title %}{% endblock %}
  </title>
  {# Font Awesome is now imported inside assets/style/main.css within its own
     CSS layer (layer(thirdparty)), so it can no longer override Tailwind
     utility classes sharing the same name (e.g. .sr-only). #}
  <link rel="icon" href="{{ channel.channelParameter.favicon }}" sizes="32x32"/>
  <meta name="viewport" content="width=device-width, initial-scale=1">

  <style>:root {
      --primary-color: {{channel_primary_color(channel)}};
      --secondary-color: {{channel_secondary_color(channel)}};
      --body-background: #f2f0f6;
      --default-text-color: {{channel_text_color(channel)}};
    }
  </style>

  {% if settings.useExternalScriptsTags and isNeoAutoLogin == false %}
    {% include '_partials/_gtm-header.html.twig' %}
  {% endif %}
  {# Keep javascripts block at the end of the head to avoid css order problems #}
  {% block javascripts %}
    <script>
      window.__ADYEN_CLIENT_KEY__ = {{ adyen_client_key() | json_encode | raw }};
      window.__ADYEN_ENVIRONMENT__ = {{ adyen_environment() | json_encode | raw }};
      window.__CARTO_API_KEY__ = {{ carto_api_key() | json_encode | raw }};
      window.APP_MODE = {{ app.request.server.get('APP_MODE')|default(null)|json_encode|raw }};
      window.MKP_GIT_TAG = {{ app.request.server.get('MKP_GIT_TAG')|default(null)|json_encode|raw }};
    </script>
    {{ vite_asset('main.ts', ['vuejs']) }}
  {% endblock %}
</head>
<body>
{% if settings.useExternalScriptsTags and isNeoAutoLogin == false %}
  {% include '_partials/_gtm-body.html.twig' %}
{% endif %}
{% if app.request.attributes.get('_maintenance_banner') %}
  <div class="w-full bg-orange-500 text-white text-center text-sm font-semibold py-2 px-4 z-50 sticky top-0">
    ⚠️ Mode maintenance actif — Vous visualisez le site en accès restreint.
  </div>
{% endif %}
{% block body %}{% endblock %}
{% if settings.getChatbot %}
  <script>
    !function (e, r, i, t) {
      if (!e[t]) {
        e[t] = function () {
          (e[t].q = e[t].q || []).push(arguments)
        }, e[t].l = 1 * new Date;
        var n = r.createElement("script"), a = r.getElementsByTagName("script")[0];
        n.async = 1, n.src = "https://assets-courier.lkbd.io/script/courier.js";
        var o = r.createElement("div");
        o.id = "lkbCourier", r.body.appendChild(o), a.parentNode.insertBefore(n, a)
      }
    }(window, document, 0, "Courier"), Courier({bot: '{{ settings.getChatbot }}'});
  </script>
{% endif %}
</body>
</html>
