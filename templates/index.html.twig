{% extends 'base.html.twig' %}

{% block title %}
  {{ channel.name }}
{% endblock %}

{% block body %}
  <div
    class="bg-white w-full md:w-2/5 lg:w-1/4 xl:w-1/3 rounded-r-3xl px-4 lg:px-10 pt-4 lg:pt-8 flex flex-col shadow-2xl">
    {% include '_partials/_header.html.twig' with {
      'show_back': channel is defined and channel.channelParameter.whiteLabel == false,
      'back_url': 'https://qantis.co/',
      'back_label': 'Retourner sur le site Qantis'
    } %}
    <div class="container sm:flex h-full mx-auto mt-4">
      <div class="flex h-full">
        <div class="vue-app w-full flex" data-component="login"></div>
      </div>
    </div>
  </div>
  <div class="hidden md:w-3/5 lg:w-2/3 md:px-10 xl:px-36 pt-32  md:flex flex-col items-center">
    <div class="vue-app md:flex h-full flex-col items-center" data-component="prehome-right-part"></div>
  </div>
{% endblock %}
