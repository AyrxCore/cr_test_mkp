<div class="flex flex-col-reverse">
  {% if show_back %}
    <a href="{{ back_url }}" class="left-0 mt-4 lg:mt-0 order-4 lg:order-1 flex items-center text-primary"
       id="btn-go-back">
      <div class="vue-app mr-3 text-primary w-[14px] h-[14px]" data-component="arrow-left-icon"></div>
      {{ back_label is defined ? back_label : '' }}
    </a>
  {% endif %}
  <div class="flex justify-center  mt-5 lg:mt-10">
    {% if channel is defined and channel.channelParameter.logo is defined %}
      <img class="max-h-[6rem] lg:max-h-32 object-contain" src="{{ channel.channelParameter.logo }}" alt="Logo">
    {% else %}
      <img class="h-full" src="/pre_home/qantis_marketplace_logo_blanc.png" alt="Logo Qantis">
    {% endif %}
  </div>

</div>
